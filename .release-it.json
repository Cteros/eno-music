{
  "plugins": {
    "release-it-pnpm": {}
  },
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore: release v${version}"
  },
  "github": {
    "release": true,
    "assets": [
      "extension.zip"
    ]
  },
  "npm": false,
  "hooks": {
    "after:bump": "pnpm build && pnpm pack:zip"
  }
}
