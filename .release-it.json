{
  "plugins": {
    "release-it-pnpm": {}
  },
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagMatch": "v[0-9]*"
  },
  "github": {
    "release": false
  },
  "npm": false,
  "hooks": {
    "after:bump": "pnpm build && pnpm pack:zip"
  }
}
